
DATABASE_URL=postgresql+psycopg2://apex:apex@localhost:5432/apex_gadgets

# Azure AI Foundry 
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Deployment names as they appear in your Foundry resource, these can
# differ from the underlying model name. All three chat deployments
# use gpt-5-mini.
AZURE_OPENAI_RELEVANCE_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_SENSITIVITY_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_SPECIALIST_DEPLOYMENT=gpt-5-mini

# Azure AI Foundry  (embeddings) 
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Pinecone 
PINECONE_API_KEY=
PINECONE_INDEX_NAME=apex-gadgets-db

#  Gmail OAuth 
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SUPPORT_ADDRESS=

# Dashboard 
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=

# App 
ENVIRONMENT=local
LOG_LEVEL=INFO
